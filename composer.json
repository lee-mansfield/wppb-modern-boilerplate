{
  "name": "your-vendor/modern-plugin",
  "description": "A modern WordPress plugin boilerplate.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": { "php": ">=8.1" },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "php-stubs/wordpress-stubs": "^6.7",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5 || ^11.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.1"
  },
  "autoload": { "classmap": ["src/"] },
  "autoload-dev": { "psr-4": { "Modern\\Plugin\\Tests\\": "tests/" } },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=512M",
    "test": "phpunit",
    "check": ["@lint", "@analyse", "@test"]
  },
  "config": { "autoloader-suffix": "modern_plugin", "allow-plugins": { "dealerdirect/phpcodesniffer-composer-installer": true, "phpstan/extension-installer": true }, "sort-packages": true }
}
