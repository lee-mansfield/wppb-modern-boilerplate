<?xml version="1.0"?>
<ruleset name="Modern Plugin">
  <description>WordPress coding standards for the plugin.</description>

  <!-- Files checked when running `phpcs` without a filename. -->
  <file>plugin-boilerplate.php</file>
  <file>src</file>
  <file>blocks</file>
  <file>templates</file>
  <file>tests</file>
  <file>uninstall.php</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/build/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*.js</exclude-pattern>

  <arg name="basepath" value="."/>
  <arg name="colors"/>
  <arg value="sp"/>

  <rule ref="WordPress-Core"/>
  <rule ref="WordPress.Files.FileName">
    <!-- PHPUnit requires test filenames to match their class names. -->
    <exclude-pattern>*/tests/*</exclude-pattern>
  </rule>
  <rule ref="WordPress-Docs"/>
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="modern-plugin"/>
      </property>
    </properties>
  </rule>

  <rule ref="WordPress.Security"/>
  <rule ref="WordPress.DB"/>
  <rule ref="WordPress.WP.DeprecatedFunctions"/>
  <rule ref="WordPress.WP.DeprecatedParameters"/>
  <rule ref="WordPress.WP.EnqueuedResources"/>
</ruleset>
